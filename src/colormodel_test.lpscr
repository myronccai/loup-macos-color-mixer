@mode(host.scripted)

# Tests of the color mixer's model (colormodel.loup): conversions, hex,
# harmonies and the Mixer's state changes.
#
#   loup test --strict src

from debug.assert import (expect, expectEq, expectThrows);
from colormodel import (Rgb, MODE_RGB, MODE_HSB, rgb, hsb, rgbToHsb, hsbToRgb, toHex,
    parseHex, rgbText, hsbText, isLight, wrapHue, roundToInt, harmonies, harmonyNames, newMixer,
    withMode, withRgb, withHsb, withHex, withChannel, channelNames, channelMax, channelText,
    parseChannel, isBlank);

## `colors` as hex strings joined with spaces.
func hexList(colors: list[Rgb]): string {
    var parts: list[string] = [];
    for (c in colors) {
        parts.push(toHex(c));
    }
    let s = parts.join(" ");
    return s;
}

## Assert that `action` throws a ValueError.
func expectValueError(action: fn(): void, context: string): void {
    let e = expectThrows(action, context);
    expect(e is ValueError, context + ": expected a ValueError, got: " + e.message);
}

# ── conversions ─────────────────────────────────────────────────────────────

func test_primaries_to_hsb(): void {
    expectEq(hsbText(rgbToHsb(rgb(255, 0, 0))), "hsb(0°, 100%, 100%)", "red");
    expectEq(hsbText(rgbToHsb(rgb(0, 255, 0))), "hsb(120°, 100%, 100%)", "green");
    expectEq(hsbText(rgbToHsb(rgb(0, 0, 255))), "hsb(240°, 100%, 100%)", "blue");
    expectEq(hsbText(rgbToHsb(rgb(255, 0, 255))), "hsb(300°, 100%, 100%)", "magenta");
    expectEq(hsbText(rgbToHsb(rgb(51, 102, 153))), "hsb(210°, 67%, 60%)", "steel blue");
}

func test_hsb_to_rgb_each_sector(): void {
    expectEq(toHex(hsbToRgb(hsb(0.0, 100.0, 100.0))), "#FF0000", "0°");
    expectEq(toHex(hsbToRgb(hsb(60.0, 100.0, 100.0))), "#FFFF00", "60°");
    expectEq(toHex(hsbToRgb(hsb(120.0, 100.0, 100.0))), "#00FF00", "120°");
    expectEq(toHex(hsbToRgb(hsb(180.0, 100.0, 100.0))), "#00FFFF", "180°");
    expectEq(toHex(hsbToRgb(hsb(240.0, 100.0, 100.0))), "#0000FF", "240°");
    expectEq(toHex(hsbToRgb(hsb(300.0, 100.0, 100.0))), "#FF00FF", "300°");
    expectEq(toHex(hsbToRgb(hsb(30.0, 100.0, 100.0))), "#FF8000", "30° rounds 127.5 up");
    expectEq(toHex(hsbToRgb(hsb(210.0, 50.0, 80.0))), "#6699CC", "a desaturated blue");
}

func test_rgb_hsb_round_trip_on_a_grid(): void {
    var r = 0;
    var failures = 0;
    var first = "";
    while (r <= 255) {
        var g = 0;
        while (g <= 255) {
            var b = 0;
            while (b <= 255) {
                let c = rgb(r, g, b);
                let back = hsbToRgb(rgbToHsb(c));
                if (toHex(back) != toHex(c)) {
                    failures = failures + 1;
                    if (first == "") {
                        first = toHex(c) + " -> " + toHex(back);
                    }
                }
                b = b + 15;
            }
            g = g + 17;
        }
        r = r + 51;
    }
    expectEq(failures, 0, "RGB -> HSB -> RGB changed a color, first: " + first);
}

func test_hsb_rgb_round_trip_of_whole_degrees(): void {
    # Fully saturated, full brightness: every whole hue survives the trip to
    # 8-bit RGB and back to within one degree.
    var h = 0;
    while (h < 360) {
        let back = rgbToHsb(hsbToRgb(hsb(h as float, 100.0, 100.0)));
        var diff = back.h - (h as float);
        if (diff < 0.0) { diff = 0.0 - diff; }
        expect(diff < 1.0, "hue " + h.to_string() + " came back as " + hsbText(back));
        h = h + 1;
    }
}

func test_grey_has_no_hue_or_saturation(): void {
    expectEq(hsbText(rgbToHsb(rgb(128, 128, 128))), "hsb(0°, 0%, 50%)", "mid grey");
    expectEq(hsbText(rgbToHsb(rgb(255, 255, 255))), "hsb(0°, 0%, 100%)", "white");
    expectEq(hsbText(rgbToHsb(rgb(0, 0, 0))), "hsb(0°, 0%, 0%)", "black");
    expectEq(toHex(hsbToRgb(hsb(200.0, 0.0, 50.0))), "#808080", "any hue at 0% saturation is grey");
    expectEq(toHex(hsbToRgb(hsb(77.0, 64.0, 0.0))), "#000000", "0% brightness is black");
}

func test_hue_wraps(): void {
    expectEq(roundToInt(wrapHue(370.0)), 10, "370 -> 10");
    expectEq(roundToInt(wrapHue(-30.0)), 330, "-30 -> 330");
    expectEq(roundToInt(wrapHue(720.0)), 0, "720 -> 0");
    expectEq(roundToInt(hsb(360.0, 50.0, 50.0).h), 0, "hsb() wraps 360 to 0");
    expectEq(toHex(hsbToRgb(hsb(-120.0, 100.0, 100.0))), "#0000FF", "-120 is 240 (blue)");
    expectEq(toHex(hsbToRgb(hsb(480.0, 100.0, 100.0))), "#00FF00", "480 is 120 (green)");
}

func test_clamping(): void {
    expectEq(rgbText(rgb(-5, 300, 128)), "rgb(0, 255, 128)", "rgb() clamps");
    expectEq(hsbText(hsb(10.0, 150.0, -20.0)), "hsb(10°, 100%, 0%)", "hsb() clamps");
}

func test_round_to_int(): void {
    expectEq(roundToInt(2.5), 3, "half up");
    expectEq(roundToInt(2.49), 2, "below half");
    expectEq(roundToInt(-2.5), -3, "half away from zero");
    expectEq(roundToInt(0.0), 0, "zero");
}

# ── hex ─────────────────────────────────────────────────────────────────────

func test_hex_round_trip(): void {
    for (text in ["#000000", "#FFFFFF", "#336699", "#0A0B0C", "#FF8000"]) {
        expectEq(toHex(parseHex(text)), text, "round trip of " + text);
    }
}

func test_hex_forms_accepted(): void {
    expectEq(rgbText(parseHex("#3366cc")), "rgb(51, 102, 204)", "lower case");
    expectEq(rgbText(parseHex("3366CC")), "rgb(51, 102, 204)", "no #");
    expectEq(rgbText(parseHex("  #3366CC ")), "rgb(51, 102, 204)", "surrounding spaces");
    expectEq(toHex(parseHex("#f80")), "#FF8800", "short form doubles each digit");
    expectEq(toHex(parseHex("abc")), "#AABBCC", "short form without #");
}

func test_invalid_hex_throws(): void {
    expectValueError(func(): void { parseHex(""); }, "empty");
    expectValueError(func(): void { parseHex("#"); }, "only #");
    expectValueError(func(): void { parseHex("#12345"); }, "five digits");
    expectValueError(func(): void { parseHex("#1234567"); }, "seven digits");
    expectValueError(func(): void { parseHex("#GG0000"); }, "G is not a hex digit");
    expectValueError(func(): void { parseHex("##123456"); }, "two #");
    expectValueError(func(): void { parseHex("red"); }, "a color name");
}

# ── harmonies ───────────────────────────────────────────────────────────────

func test_harmonies_of_red(): void {
    let h = harmonies(rgbToHsb(rgb(255, 0, 0)));
    expectEq(h.len(), 5, "five harmony colors");
    expectEq(hexList(h), "#00FFFF #FF0080 #FF8000 #00FF00 #0000FF", "complement, analogous, triadic");
    expectEq(harmonyNames().len(), 5, "one name per harmony");
}

func test_harmonies_wrap_the_hue(): void {
    # Hue 350: complement 170, analogous 320 and 20, triadic 110 and 230.
    let base = hsb(350.0, 100.0, 100.0);
    let h = harmonies(base);
    expectEq(roundToInt(rgbToHsb(h[0]).h), 170, "complement");
    expectEq(roundToInt(rgbToHsb(h[1]).h), 320, "analog -30");
    expectEq(roundToInt(rgbToHsb(h[2]).h), 20, "analog +30 wraps past 360");
    expectEq(roundToInt(rgbToHsb(h[3]).h), 110, "triad +120 wraps");
    expectEq(roundToInt(rgbToHsb(h[4]).h), 230, "triad +240 wraps");
}

func test_harmonies_of_grey_are_grey(): void {
    let h = harmonies(rgbToHsb(rgb(128, 128, 128)));
    expectEq(hexList(h), "#808080 #808080 #808080 #808080 #808080", "a grey has no hue to turn");
}

func test_is_light(): void {
    expect(isLight(rgb(255, 255, 255)), "white is light");
    expect(isLight(rgb(255, 255, 0)), "yellow is light");
    expect(not isLight(rgb(0, 0, 255)), "blue is dark");
    expect(not isLight(rgb(0, 0, 0)), "black is dark");
}

# ── the mixer ───────────────────────────────────────────────────────────────

func test_mixer_channels_follow_the_mode(): void {
    let m = newMixer(rgb(51, 102, 153));
    expectEq(m.mode, MODE_RGB, "starts in RGB mode");
    expectEq(channelText(m, 0) + " " + channelText(m, 1) + " " + channelText(m, 2), "51 102 153", "rgb");
    let h = withMode(m, MODE_HSB);
    expectEq(channelText(h, 0) + " " + channelText(h, 1) + " " + channelText(h, 2), "210 67 60", "hsb");
    expectEq(channelNames(MODE_HSB)[2], "Brightness", "hsb names");
    expectEq(channelNames(MODE_RGB)[0], "Red", "rgb names");
    expectEq(roundToInt(channelMax(MODE_HSB, 0)), 360, "hue range");
    expectEq(roundToInt(channelMax(MODE_HSB, 1)), 100, "saturation range");
    expectEq(roundToInt(channelMax(MODE_RGB, 2)), 255, "blue range");
    expectValueError(func(): void { withMode(m, 7); }, "unknown mode");
}

func test_mixer_with_channel(): void {
    let m = newMixer(rgb(0, 0, 0));
    let red = withChannel(m, 0, 255.0);
    expectEq(toHex(red.rgb), "#FF0000", "red channel");
    let clamped = withChannel(red, 1, 999.0);
    expectEq(toHex(clamped.rgb), "#FFFF00", "clamped to 255");
    let hsbm = withMode(newMixer(rgb(255, 0, 0)), MODE_HSB);
    let turned = withChannel(hsbm, 0, 240.0);
    expectEq(toHex(turned.rgb), "#0000FF", "hue to 240");
    let dim = withChannel(turned, 2, 50.0);
    expectEq(toHex(dim.rgb), "#000080", "brightness to 50");
    expectValueError(func(): void { withChannel(m, 3, 1.0); }, "no channel 3");
}

func test_mixer_keeps_hue_360(): void {
    let m = withMode(newMixer(rgb(255, 136, 0)), MODE_HSB);
    let end = withChannel(m, 0, 360.0);
    expectEq(channelText(end, 0), "360", "the hue slider's right end stays 360");
    expectEq(toHex(end.rgb), "#FF0000", "360 is red, like 0");
    expectEq(hexList(harmonies(end.hsb)), hexList(harmonies(withChannel(m, 0, 0.0).hsb)), "same harmonies as 0");
    let typed = withChannel(m, 0, 500.0);
    expectEq(channelText(typed, 0), "360", "a typed 500 is clamped to 360, not wrapped");
    let grey = withRgb(end, rgb(90, 90, 90));
    expectEq(channelText(grey, 0), "360", "a grey keeps the hue 360");
}

func test_mixer_keeps_hue_through_grey_and_black(): void {
    let m = withMode(newMixer(rgb(255, 0, 0)), MODE_HSB);
    let teal = withChannel(m, 0, 180.0);
    let black = withChannel(teal, 2, 0.0);
    expectEq(toHex(black.rgb), "#000000", "brightness 0 is black");
    let back = withChannel(black, 2, 100.0);
    expectEq(toHex(back.rgb), "#00FFFF", "the hue and saturation survive black");
    let grey = withChannel(back, 1, 0.0);
    expectEq(toHex(grey.rgb), "#FFFFFF", "saturation 0 is white here");
    let again = withChannel(grey, 1, 100.0);
    expectEq(toHex(again.rgb), "#00FFFF", "the hue survives grey");
    let rgb_grey = withRgb(again, rgb(90, 90, 90));
    expectEq(roundToInt(rgb_grey.hsb.h), 180, "an RGB grey keeps the hue");
}

func test_mixer_with_hex_and_hsb(): void {
    let m = withHex(newMixer(rgb(0, 0, 0)), "#336699");
    expectEq(rgbText(m.rgb), "rgb(51, 102, 153)", "hex sets rgb");
    expectEq(hsbText(m.hsb), "hsb(210°, 67%, 60%)", "and hsb");
    expectValueError(func(): void { withHex(m, "#33669"); }, "bad hex");
    let h = withHsb(m, hsb(120.0, 100.0, 100.0));
    expectEq(toHex(h.rgb), "#00FF00", "withHsb sets rgb");
}

func test_parse_channel(): void {
    expectEq(parseChannel("128"), 128, "digits");
    expectEq(parseChannel(" 7 "), 7, "spaces");
    expectEq(parseChannel("0"), 0, "zero");
    expectValueError(func(): void { parseChannel(""); }, "empty");
    expectValueError(func(): void { parseChannel("12a"); }, "a letter");
    expectValueError(func(): void { parseChannel("-4"); }, "a sign");
    expectValueError(func(): void { parseChannel("1234567"); }, "too long");
    expect(isBlank(""), "an empty field is blank");
    expect(isBlank("  "), "spaces are blank");
    expect(not isBlank(" 1"), "a digit is not blank");
}
